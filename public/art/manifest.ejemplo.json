{
  "_leeme": "Renombra a manifest.json. Frames en UNA fila; pueden ser no cuadrados (se mide la tira). Un gesto puede ser una LISTA de clips: se elige uno al azar (ataques variados). 'golpea_<arma>' da al protagonista un ataque distinto por arma: rayo, gancho, tenaza, onda, lluvia, barrido, maza, perdigon. 'proyectiles/<arma>' reemplaza el proyectil CSS por un sprite.",

  "jugador/copista": {
    "quieto":         { "src": "sprites/adventurer/idle.png",      "frames": 4, "fps": 6 },
    "golpea":        [{ "src": "sprites/adventurer/attack1.png",   "frames": 5, "fps": 12 },
                      { "src": "sprites/adventurer/attack2.png",   "frames": 6, "fps": 12 },
                      { "src": "sprites/adventurer/attack3.png",   "frames": 6, "fps": 12 }],
    "golpea_lluvia":  { "src": "sprites/adventurer/bow-shoot.png", "frames": 9, "fps": 12 },
    "golpea_rayo":    { "src": "sprites/adventurer/cast.png",      "frames": 4, "fps": 10 },
    "herido":         { "src": "sprites/adventurer/hurt.png",      "frames": 3, "fps": 8 }
  },

  "enemigos/rumor": {
    "quieto":  { "src": "sprites/ghost_warrior/idle.png",    "frames": 8, "fps": 8 },
    "avanza":  { "src": "sprites/ghost_warrior/run.png",     "frames": 8, "fps": 10 },
    "golpea": [{ "src": "sprites/ghost_warrior/attack1.png", "frames": 8, "fps": 12 },
               { "src": "sprites/ghost_warrior/attack2.png", "frames": 8, "fps": 12 }],
    "herido":  { "src": "sprites/ghost_warrior/hurt.png",    "frames": 4, "fps": 10 },
    "cae":     { "src": "sprites/ghost_warrior/death.png",   "frames": 8, "fps": 8, "loop": false },
    "volteado": true
  },

  "proyectiles/lluvia": { "src": "sprites/vfx/arrow.png",    "frames": 1 },
  "proyectiles/rayo":   { "src": "sprites/vfx/bolt.png",     "frames": 4, "fps": 16 }
